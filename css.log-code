.input-box{
  position: relative;
  margin-bottom: 15px;
}
#loginBtn{
  width: 100%;
  padding: 14px;
  margin-top: 18px;
  border: none;
  border-radius: 10px;
  background: #38bdf8;
  color: #01172a;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  transition: 0.3s;
}
#loginBtn:hover{
  background: #0ea5e9;
  color: white;
}
.link{
  text-align: center;
  font-size: 14px;
  color: #94a3b8;
  margin-top: 12px;
}
.link a{
  color: #38bdf8;
  text-decoration: none;
}